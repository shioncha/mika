{
  "name": "Mika Backend Dev",
  "dockerComposeFile": ["../../compose.yaml", "../../compose.override.yaml"],
  "service": "backend",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/backend",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind"
  ],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.Go"],
      "settings": {
        "git.openRepositoryInParentFolders": "always",
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "go.goroot": "/usr/local/go"
      }
    }
  }
}
